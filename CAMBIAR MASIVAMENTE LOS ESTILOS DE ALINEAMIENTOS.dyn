    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('AeccDbMgd')\r\nclr.AddReference('AcDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.Civil.DatabaseServices import Alignment\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode, BlockTableRecord\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\ncivDoc = CivilApplication.ActiveDocument\r\n\r\nstyle_list = IN[0]\r\nselected_index = IN[1]\r\nresults = []\r\ntarget_style_id = None\r\n\r\nif style_list is None or selected_index is None:\r\n    OUT = \"Conecta los nodos correctamente\"\r\nelse:\r\n    style_name = style_list[selected_index]\r\n    with doc.LockDocument():\r\n        with db.TransactionManager.StartTransaction() as tr:\r\n            for styleId in civDoc.Styles.AlignmentStyles:\r\n                style = tr.GetObject(styleId, OpenMode.ForRead)\r\n                if style.Name == style_name:\r\n                    target_style_id = styleId\r\n                    break\r\n\r\n            if target_style_id is None:\r\n                OUT = \"Estilo no encontrado: \" + style_name\r\n            else:\r\n                bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\r\n                btr = tr.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForRead)\r\n\r\n                for objId in btr:\r\n                    obj = tr.GetObject(objId, OpenMode.ForRead)\r\n                    if isinstance(obj, Alignment):\r\n                        obj.UpgradeOpen()\r\n                        obj.StyleId = target_style_id\r\n                        results.append(obj.Name)\r\n\r\n                tr.Commit()\r\n                OUT = results\r\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "92ee08ab9ddf4355814fb528eb9b39f4",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "506aaa89cbbc4881abe356bdf6a1206d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "42d12e85eb50452fa01d5c271fca7541",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "891d4cd17f174d97b6d0bf57e204e310",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('AeccDbMgd')\r\nclr.AddReference('AcDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\ncivDoc = CivilApplication.ActiveDocument\r\n\r\nresults = []\r\n\r\nwith doc.LockDocument():\r\n    with db.TransactionManager.StartTransaction() as tr:\r\n        for styleId in civDoc.Styles.AlignmentStyles:\r\n            style = tr.GetObject(styleId, OpenMode.ForRead)\r\n            results.append(style.Name)\r\n        tr.Commit()\r\n\r\nOUT = results\r\n",
