  "Name": "RENUMERACION DE LAYOUTS",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import *\nfrom Autodesk.AutoCAD.Runtime import *\nimport re\ndoc = Application.DocumentManager.MdiActiveDocument\ndb = doc.Database\nprefix = IN[0] if IN[0] is not None else None\nstart_number = int(IN[1]) if IN[1] is not None else 1\npadding = int(IN[2]) if IN[2] else 2\nclean_pattern = re.compile(r'^\\s*(?:[A-Za-z]{0,3}-)?\\d+\\s*[-_]\\s*', re.IGNORECASE)\nrenamed = []\nwith doc.LockDocument():\n    with db.TransactionManager.StartTransaction() as tr:\n        layout_dict = tr.GetObject(db.LayoutDictionaryId, OpenMode.ForRead)\n        layouts_in_order = []\n        for entry in layout_dict:\n            lid = entry.Value\n            lyt = tr.GetObject(lid, OpenMode.ForRead)\n            name = lyt.LayoutName\n            if name.lower() != \"model\":\n                layouts_in_order.append((lyt.TabOrder, name, lid))\n        layouts_in_order.sort(key=lambda x: x[0])\n        layout_names = [n for _, n, _ in layouts_in_order]\n        for idx, original in enumerate(layout_names):\n            new_number = start_number + idx\n            if prefix:\n                new_name = \"{0}-{1:0{2}d}\".format(prefix, new_number, padding)\n            elif prefix == \"\":\n                new_name = \"{1:0{2}d}\".format(prefix, new_number, padding)\n            else:\n                new_name = \"{0:0{1}d}\".format(new_number, padding)\n            block_id = layout_dict.GetAt(original)\n            lyt = tr.GetObject(block_id, OpenMode.ForWrite)\n            lyt.LayoutName = new_name\n            renamed.append(\"'{0}' -> '{1}'\".format(original, new_name))\n        tr.Commit()\nOUT = renamed",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
